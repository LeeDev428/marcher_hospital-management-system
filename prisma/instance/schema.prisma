generator client {
    provider = "prisma-client-js"
    output   = "../generated/instance"
}

datasource db {
    provider = "postgresql"
    url      = env("INSTANCE_DATABASE_URL")
}

// Enhanced User Model - Single table for all users
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Hashed password
  firstName String
  lastName  String
  middleName String?
  phone     String?
  role      UserRole @default(PATIENT)
  status    UserStatus @default(ACTIVE)
  isEmailVerified Boolean @default(false)
  emailVerifiedAt DateTime?
  
  // Profile information
  avatar    String?
  dateOfBirth DateTime?
  gender    Gender?
  address   String?
  city      String?
  province  String?
  zipCode   String?
  
  // Staff-specific fields (only used when role = STAFF)
  staffNumber     String?   @unique  // Auto-generated for staff
  department      String?            // Department they work in
  position        String?            // Job position
  hireDate        DateTime?          // When they were hired
  salary          Decimal?           // Salary information
  employmentType  EmploymentType?    // Full-time, part-time, contract
  
  // System fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?
  
  // Relationships
  refreshTokens RefreshToken[]
  passwordResets PasswordResetToken[]
  patientProfile Patient?
  partnerProfile Partner?
  staffCredentials StaffCredentials?  // Professional credentials for staff
  appointments Appointment[]
  medicalServices MedicalService[]   // Services offered by this staff member
  
  // Audit fields
  createdBy String?
  updatedBy String?
  
  @@map("users")
}

// Staff Credentials - For doctors, nurses, and other medical staff
model StaffCredentials {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Professional Type
  staffType StaffType // DOCTOR, NURSE, TECHNICIAN, etc.
  
  // License and Certifications
  licenseNumber     String?
  licenseExpiryDate DateTime?
  qualification     String?   // Educational degrees: MD, MBBS, RN, BSN, etc.
  specialization    String?   // Medical specialty: Cardiology, Pediatrics, etc.
  subSpecialization String?
  boardCertification String[]  // Array of certifications
  
  // Education and Experience
  education         String?
  yearsOfExperience Int?
  
  // Medical staff specific fields
  consultationFee   Decimal?  // For doctors
  isAvailable       Boolean   @default(true)
  workingHours      Json?     // Flexible schedule data
  
  // Hospital/Institution info
  hospitalAffiliation String?
  
  // System fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("staff_credentials")
}

// Patient Profile (simplified)
model Patient {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientNumber  String    @unique
  
  // Medical Information
  bloodType      BloodType?
  allergies      String?
  medicalHistory String?
  emergencyContact String?
  emergencyPhone String?
  
  // Insurance Information
  insuranceProvider String?
  insuranceNumber   String?
  
  // Relationships
  inpatientEncounters  InpatientEncounter[]
  outpatientEncounters OutpatientEncounter[]
  insuranceClaims      InsuranceClaim[]
  dataShareRequests    DataShareRequest[]
  billingTransactions  BillingTransaction[]
  
  // System fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("patients")
}

// Partner Profile (Hospital/Clinic)
model Partner {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionName String
  institutionType PartnerType
  licenseNumber   String?
  
  // Contact Information
  website         String?
  contactPerson   String?
  
  // System fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("partners")
}

// Refresh Tokens for JWT
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("refresh_tokens")
}

// Password Reset Tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token, expiresAt, used])
  @@map("password_reset_tokens")
}

// Appointments Model
model Appointment {
  id          String   @id @default(cuid())
  userId      String   // Patient's user ID - references User.id
  user        User     @relation(fields: [userId], references: [id])
  doctorId    String   // References User.id where role = STAFF and staffType = DOCTOR
  
  // Medical Service
  medicalServiceId String?  // References MedicalService.id
  medicalService   MedicalService? @relation(fields: [medicalServiceId], references: [id])
  
  // Appointment details
  date        String   // Date in YYYY-MM-DD format
  time        String   // Time in HH:MM format (24-hour)
  duration    Int?     // Duration in minutes
  type        AppointmentType?
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?
  notes       String?
  facilityId  String?  // Room assignment
  
  // System fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("appointments")
  @@index([userId])
  @@index([doctorId])
  @@index([medicalServiceId])
  @@index([date])
  @@index([status])
}

// ENUMS

// User Roles
enum UserRole {
  ADMIN
  STAFF     // Covers doctors, nurses, technicians, etc.
  PATIENT
  PARTNER
}

// Staff Types (for detailed classification)
enum StaffType {
  DOCTOR
  NURSE
  STAFF
  ADMISSIONS_STAFF
  BILLING_STAFF
  PHARMACIST
}

// Employment Types
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CONSULTANT
  INTERN
}

// User Status
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

// Gender Enum
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// Partner Type Enum
enum PartnerType {
  HOSPITAL
  CLINIC
  LABORATORY
  PHARMACY
  DIAGNOSTIC_CENTER
}

// Blood Type Enum
enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

// Appointment Types
enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
  PROCEDURE
  CHECKUP
}

// Appointment Status
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Day of Week for schedule
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Staff Schedule - Weekly availability
model StaffSchedule {
  id        String   @id @default(cuid())
  staffId   String   // User ID of the staff member
  day       DayOfWeek
  isAvailable Boolean @default(false)
  startTime String?  // HH:mm format
  endTime   String?  // HH:mm format
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([staffId, day])
  @@map("staff_schedules")
}

// Medical Services - Services offered by staff
model MedicalService {
  id          String   @id @default(cuid())
  staffId     String   // User ID of the staff member offering this service
  staff       User     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  name        String   // Service name (e.g., "General Consultation", "Blood Pressure Check")
  type        ServiceType // Type of service
  category    ServiceCategory? // Optional category for grouping
  description String?  // Detailed description of the service
  price       Decimal  @db.Decimal(10, 2) // Price in currency
  duration    Int      // Duration in minutes
  isActive    Boolean  @default(true) // Can be disabled without deleting
  
  // Additional fields
  requirements String?  // Any requirements/preparations needed
  notes        String?  // Internal notes
  
  // Relations
  appointments Appointment[] // Appointments using this service
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([staffId])
  @@index([type])
  @@index([isActive])
  @@map("medical_services")
}

// Service Type Enum
enum ServiceType {
  CONSULTATION           // General consultation
  FOLLOW_UP             // Follow-up consultation
  MINOR_PROCEDURE       // Minor procedures (injections, wound care, etc.)
  MAJOR_PROCEDURE       // Major procedures (surgery, etc.)
  DIAGNOSTIC_TEST       // Diagnostic tests
  VACCINATION           // Vaccination services
  HEALTH_CHECKUP        // General health checkup
  SPECIALIZED_CONSULTATION // Specialized consultation
  EMERGENCY_CARE        // Emergency care
  PREVENTIVE_CARE       // Preventive care
  THERAPY               // Physical therapy, occupational therapy, etc.
  COUNSELING            // Mental health counseling
  OTHER                 // Other services
}

// Service Category Enum (for better organization)
enum ServiceCategory {
  GENERAL_MEDICINE
  SURGERY
  PEDIATRICS
  OBSTETRICS_GYNECOLOGY
  ORTHOPEDICS
  CARDIOLOGY
  NEUROLOGY
  DERMATOLOGY
  OPHTHALMOLOGY
  ENT
  PSYCHIATRY
  RADIOLOGY
  LABORATORY
  NURSING
  THERAPY
  EMERGENCY
  OTHER
}

// ==================== FACILITIES MODELS ====================

// Building model for hospital buildings
model Building {
  id          String   @id @default(cuid())
  name        String   // Building name (e.g., "Main Hospital", "Outpatient Clinic")
  code        String   @unique // Building code (e.g., "MH-01")
  description String?
  address     String?
  floors      Int      @default(1)
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("buildings")
}

// Room model for hospital rooms/facilities
model Room {
  id          String     @id @default(cuid())
  building    String?    // Building name (text field)
  
  identifier  String     // Room number/identifier (e.g., "101", "ER-1")
  type        RoomType
  description String?
  capacity    Int        @default(1) // Number of beds/capacity
  status      RoomStatus @default(AVAILABLE)
  
  floor       Int?
  wing        String?    // Wing/section (e.g., "North Wing")
  amenities   String?    // JSON string of amenities
  notes       String?
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  @@index([type])
  @@index([status])
  @@map("rooms")
}

// Facility Log for audit trail
model FacilityLog {
  id             String   @id @default(cuid())
  user           String   // User who made the change
  role           String   // User role
  action         String   // Action performed
  roomIdentifier String   // Room identifier
  type           String   // Room type
  oldStatus      String?  // Previous status
  newStatus      String?  // New status
  timestamp      DateTime @default(now())
  
  @@index([roomIdentifier])
  @@index([timestamp])
  @@map("facility_logs")
}

// Room Type Enum
enum RoomType {
  PATIENT_ROOM         // Regular patient room
  ICU                  // Intensive Care Unit
  EMERGENCY_ROOM       // Emergency room
  OPERATING_ROOM       // Operating room/Surgery
  CONSULTATION_ROOM    // Consultation/Examination room
  LABORATORY           // Laboratory
  RADIOLOGY            // Radiology/Imaging room
  PHARMACY             // Pharmacy
  STORAGE              // Storage room
  OFFICE               // Office space
  WAITING_AREA         // Waiting area
  CAFETERIA            // Cafeteria
  OTHER                // Other
}

// Room Status Enum
enum RoomStatus {
  AVAILABLE            // Available for use
  OCCUPIED             // Currently occupied
  RESERVED             // Reserved/Booked
  MAINTENANCE          // Under maintenance
  CLEANING             // Being cleaned
  OUT_OF_SERVICE       // Out of service
}

// ==================== PHARMACY MODELS ====================

// Pharmacy Supplier
model PharmacySupplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String?
  contact   String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([email])
  @@index([contact])
  @@map("pharmacy_suppliers")
}

// Pharmacy Brand
model PharmacyBrand {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  items     PharmacyItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([name])
  @@map("pharmacy_brands")
}

// Pharmacy Item Category
model PharmacyItemCategory {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  items     PharmacyItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([name])
  @@map("pharmacy_item_categories")
}

// Pharmacy Item Forms
enum PharmacyItemForm {
  TABLET
  CAPSULE
  SYRUP
  OINTMENT
  CREAM
  INJECTION
  DROPS
  INHALER
  MEDICAL_DEVICE
  SUPPLEMENTS
  COSMETICS
  MISCELLANEOUS
}

// Pharmacy Item Routes
enum PharmacyItemRoute {
  INJECTION
  TOPICAL
  TRANSDERMAL
  OCULAR
  OTIC
  NASAL
  ORAL
  INHALATIONAL
  RECTAL
  VAGINAL
}

// Pharmacy Item
model PharmacyItem {
  id         String               @id @default(uuid()) @db.Uuid
  brandId    String               @db.Uuid
  brand      PharmacyBrand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId String               @db.Uuid
  category   PharmacyItemCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name       String
  form       PharmacyItemForm
  route      PharmacyItemRoute
  strength   String
  stock      Int
  unit       String
  price      Decimal              @default(0) @db.Decimal(10, 2)
  sku        String?
  saleItems  PharmacySaleItem[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([name])
  @@map("pharmacy_items")
}

// Payment Methods
enum PaymentMethod {
  CASH
  CARD
  ONLINE
  INSURANCE
  MAYA              // Maya payment gateway
  PAYMAYA           // Legacy PayMaya
  BANK_TRANSFER
  CHECK
  CREDIT_CARD
  DEBIT_CARD
}

// Payment Status
enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
  FAILED
}

// Pharmacy Sale (POS)
model PharmacySale {
  id              String             @id @default(uuid()) @db.Uuid
  invoiceNumber   String             @unique
  customerName    String?
  customerPhone   String?
  staffId         String?
  subtotal        Decimal            @db.Decimal(10, 2)
  discount        Decimal            @default(0) @db.Decimal(10, 2)
  tax             Decimal            @default(0) @db.Decimal(10, 2)
  total           Decimal            @db.Decimal(10, 2)
  amountPaid      Decimal?           @db.Decimal(10, 2) // Amount customer actually paid
  changeGiven     Decimal?           @db.Decimal(10, 2) // Change returned to customer (calculated: amountPaid - total)
  paymentMethod   PaymentMethod      @default(CASH)
  paymentStatus   PaymentStatus      @default(COMPLETED)
  notes           String?
  items           PharmacySaleItem[]
  payments        PharmacyPayment[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([invoiceNumber])
  @@index([createdAt])
  @@index([staffId])
  @@map("pharmacy_sales")
}

// Pharmacy Sale Item
model PharmacySaleItem {
  id              String        @id @default(uuid()) @db.Uuid
  saleId          String        @db.Uuid
  sale            PharmacySale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  pharmacyItemId  String        @db.Uuid
  pharmacyItem    PharmacyItem  @relation(fields: [pharmacyItemId], references: [id], onDelete: Restrict)
  quantity        Int
  unitPrice       Decimal       @db.Decimal(10, 2)
  subtotal        Decimal       @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([saleId])
  @@index([pharmacyItemId])
  @@map("pharmacy_sale_items")
}

// Pharmacy Payment
model PharmacyPayment {
  id              String        @id @default(uuid()) @db.Uuid
  saleId          String        @db.Uuid
  sale            PharmacySale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod @default(CASH)
  transactionId   String?
  paidAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([saleId])
  @@map("pharmacy_payments")
}

// ==================== ENCOUNTERS MODULE ====================

// Outpatient Encounter Types
enum OutpatientEncounterType {
  CONSULTATION
  FOLLOW_UP
  LABORATORY
  RADIOLOGY
  OTHER
}

// Outpatient Payment Status
enum OutpatientPaymentStatus {
  PAID
  UNPAID
}

// Outpatient Encounter - Created by doctors for consultations
model OutpatientEncounter {
  id               String                    @id @default(uuid()) @db.Uuid
  patientId        String                    
  patient          Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String                    // User ID of the doctor
  date             String                    // Date in YYYY-MM-DD format
  time             String                    // Time in HH:MM format
  chiefComplaint   String                    // Main reason for visit
  doctorDiagnosis  String?                   // Doctor's diagnosis
  type             OutpatientEncounterType   @default(CONSULTATION)
  consultationFee  Decimal?                  @db.Decimal(10, 2) // Doctor sets this directly
  paymentStatus    OutpatientPaymentStatus   @default(UNPAID)
  notes            String?                   // Additional notes
  insuranceClaim   InsuranceClaim?           // Insurance claim for this encounter
  dataShareRequest DataShareRequest?         // Data share request for this encounter
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@map("outpatient_encounters")
}

// Inpatient Triage Levels
enum InpatientTriage {
  HIGH_PRIORITY
  MEDIUM_PRIORITY
  LOW_PRIORITY
  NON_URGENT
}

// Inpatient Disposition Status
enum InpatientDisposition {
  ADMITTED
  DISCHARGED
  DISCONTINUED
  TRANSFERRED
  DECEASED
  OTHER
}

// Inpatient Encounter - Created by admissions staff
model InpatientEncounter {
  id                   String                    @id @default(uuid()) @db.Uuid
  patientId            String                    
  patient              Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId             String                    // Assigned doctor (User ID)
  admittedBy           String?                   // Admissions staff who created this (User ID)
  date                 String                    // Admission date in YYYY-MM-DD format
  time                 String                    // Admission time in HH:MM format
  chiefComplaint       String                    // Initial complaint/reason for admission
  doctorDiagnosis      String?                   // Doctor's diagnosis
  triage               InpatientTriage           // Priority level
  disposition          InpatientDisposition      @default(ADMITTED)
  dispositionDate      String?                   // Discharge/transfer date
  dispositionTime      String?                   // Discharge/transfer time
  dispositionNote      String?                   // Notes about disposition
  charts               InpatientEncounterChart[] // Progress notes by doctor
  orders               InpatientEncounterOrder[] // Orders/particulars added by doctor
  insuranceClaim       InsuranceClaim?           // Insurance claim for this encounter
  dataShareRequest     DataShareRequest?         // Data share request for this encounter
  billingTransaction   BillingTransaction?       // Billing transaction for this encounter
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([disposition])
  @@index([date])
  @@map("inpatient_encounters")
}

// Inpatient Encounter Chart - Progress notes added by doctor
model InpatientEncounterChart {
  id          String             @id @default(uuid()) @db.Uuid
  encounterId String             @db.Uuid
  encounter   InpatientEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  staffId     String             // Doctor who added the chart (User ID)
  chart       String             // Chart/progress note content
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([encounterId])
  @@index([staffId])
  @@map("inpatient_encounter_charts")
}

// Inpatient Encounter Order Types
enum InpatientEncounterOrderType {
  PRESCRIPTION
  LABORATORY
  RADIOLOGY
  OPERATION
  PROCEDURE
  OTHER
}

// Inpatient Encounter Order Status
enum InpatientEncounterOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Inpatient Encounter Order - Orders/particulars added by doctor from catalogue
model InpatientEncounterOrder {
  id              String                        @id @default(uuid()) @db.Uuid
  encounterId     String                        @db.Uuid
  encounter       InpatientEncounter            @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  catalogueItemId String?                       @db.Uuid // Reference to ParticularCatalogue
  catalogueItem   ParticularCatalogue?          @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)
  type            InpatientEncounterOrderType
  description     String                        // Order description
  cost            Decimal                       @db.Decimal(10, 2) // Cost from catalogue or custom
  status          InpatientEncounterOrderStatus @default(PENDING)
  orderedBy       String                        // Doctor who ordered (User ID)
  notes           String?                       // Additional notes
  billingLineItems BillingLineItem[]            // Link to billing
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([encounterId])
  @@index([catalogueItemId])
  @@index([status])
  @@map("inpatient_encounter_orders")
}

// ==================== PARTICULARS CATALOGUE ====================

// Particular Item Types (matches InpatientEncounterOrderType)
enum ParticularType {
  PRESCRIPTION
  LABORATORY
  RADIOLOGY
  OPERATION
  PROCEDURE
  OTHER
}

// Particulars Catalogue - Managed by billing staff
model ParticularCatalogue {
  id          String                    @id @default(uuid()) @db.Uuid
  type        ParticularType
  name        String                    // e.g., "Hepatitis A Blood Test"
  description String?                   // Detailed description
  cost        Decimal                   @db.Decimal(10, 2) // Standard cost
  isActive    Boolean                   @default(true) // Can be disabled
  orders      InpatientEncounterOrder[] // Orders that used this catalogue item
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([type])
  @@index([isActive])
  @@index([name])
  @@map("particular_catalogue")
}

// ==================== INSURANCE SYSTEM ====================

// Insurance Claim Status
enum InsuranceClaimStatus {
  PENDING       // Waiting for documents upload
  SUBMITTED     // Documents uploaded, token sent
  UNDER_REVIEW  // Insurance company reviewing
  APPROVED      // Claim approved by insurance
  DENIED        // Claim denied by insurance
  CANCELLED     // Cancelled by billing staff
  PROCESSING    // Being processed
}

// Insurance Claims - Main claim record
model InsuranceClaim {
  id                String                @id @default(uuid()) @db.Uuid
  claimNumber       String                @unique // Auto-generated: INS-YYYYMMDD-XXXX
  
  // Patient and Encounter
  patientId         String
  patient           Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  // Can be either inpatient or outpatient encounter
  inpatientEncounterId  String?           @unique @db.Uuid
  inpatientEncounter    InpatientEncounter?  @relation(fields: [inpatientEncounterId], references: [id], onDelete: Cascade)
  
  outpatientEncounterId String?           @unique @db.Uuid
  outpatientEncounter   OutpatientEncounter? @relation(fields: [outpatientEncounterId], references: [id], onDelete: Cascade)
  
  // Insurance Details
  insuranceProvider String                // Insurance company name
  insuranceNumber   String?               // Patient's insurance number
  policyNumber      String?               // Policy number
  
  // Claim Details
  claimAmount       Decimal               @db.Decimal(10, 2) // Total amount claimed
  approvedAmount    Decimal?              @db.Decimal(10, 2) // Amount approved by insurance
  denialReason      String?               // Reason if denied
  
  // Status and workflow
  status            InsuranceClaimStatus  @default(PENDING)
  submittedAt       DateTime?             // When documents were submitted
  reviewedAt        DateTime?             // When insurance reviewed
  
  // Notes
  billingStaffNotes String?               // Notes from billing staff
  insuranceNotes    String?               // Notes from insurance company
  
  // Staff who created/managed
  createdBy         String                // User ID of billing staff
  reviewedBy        String?               // Email of insurance reviewer
  
  // Relationships
  documents         InsuranceDocument[]
  accessTokens      InsuranceAccessToken[]
  
  // System fields
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  
  @@index([patientId])
  @@index([status])
  @@index([claimNumber])
  @@index([insuranceProvider])
  @@map("insurance_claims")
}

// Insurance Documents - Files uploaded for claim
model InsuranceDocument {
  id              String            @id @default(uuid()) @db.Uuid
  claimId         String            @db.Uuid
  claim           InsuranceClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  
  // Document details
  documentType    String            // e.g., "Medical Certificate", "Laboratory Results", "Prescription"
  fileName        String            // Original file name
  fileUrl         String            // Path or URL to stored file
  fileSize        Int               // Size in bytes
  mimeType        String            // File MIME type
  
  // Metadata
  description     String?           // Optional description
  uploadedBy      String            // User ID who uploaded
  
  // System fields
  createdAt       DateTime          @default(now())
  
  @@index([claimId])
  @@map("insurance_documents")
}

// Insurance Access Tokens - For insurance company to access claim
model InsuranceAccessToken {
  id              String            @id @default(uuid()) @db.Uuid
  claimId         String            @db.Uuid
  claim           InsuranceClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  
  // Token details
  token           String            @unique // Secure random token
  recipientEmail  String            // Insurance company email
  
  // Expiration and usage
  expiresAt       DateTime          // Token expiration (e.g., 7 days)
  usedAt          DateTime?         // When token was first used
  isRevoked       Boolean           @default(false) // Can be manually revoked
  
  // System fields
  createdAt       DateTime          @default(now())
  
  @@index([token])
  @@index([claimId])
  @@index([expiresAt])
  @@map("insurance_access_tokens")
}

// ============================================
// DATA SHARING SYSTEM (Doctor/Nurse → 3rd Party Hospitals)
// ============================================

// Data Share Requests - For sharing patient data with external hospitals
model DataShareRequest {
  id                  String              @id @default(uuid()) @db.Uuid
  requestNumber       String              @unique // Auto-generated: DSR-YYYYMMDD-XXXX
  
  // Patient and Encounter
  patientId           String
  patient             Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  // Can be either inpatient or outpatient encounter
  inpatientEncounterId  String?           @unique @db.Uuid
  inpatientEncounter    InpatientEncounter?  @relation(fields: [inpatientEncounterId], references: [id], onDelete: Cascade)
  
  outpatientEncounterId String?           @unique @db.Uuid
  outpatientEncounter   OutpatientEncounter? @relation(fields: [outpatientEncounterId], references: [id], onDelete: Cascade)
  
  // Request Details
  hospitalIdentifier  String              // 3rd party hospital ID/name
  hospitalName        String              // Hospital name
  hospitalEmail       String              // Hospital email for access link
  reason              String              // Reason for data sharing request
  
  // Status and workflow
  status              DataShareStatus     @default(PENDING)
  submittedAt         DateTime?           // When submitted for review
  reviewedAt          DateTime?           // When staff reviewed
  accessedAt          DateTime?           // When hospital accessed data
  
  // Data Selection (JSON - which encounter particulars to share)
  selectedData        Json?               // Array of data types: ["vitals", "diagnosis", "medications", "labs"]
  
  // Notes
  requestNotes        String?             // Notes from requesting doctor/nurse
  reviewNotes         String?             // Notes from reviewing staff
  denialReason        String?             // Reason if denied
  
  // Actors
  requestedBy         String              // Doctor/Nurse user ID
  reviewedBy          String?             // Staff user ID who approved/denied
  
  // Patient Consent
  patientConsent      Boolean             @default(false)
  
  // Relationships
  documents           DataShareDocument[]
  accessTokens        DataShareAccessToken[]
  
  // System fields
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  
  @@index([patientId])
  @@index([status])
  @@index([requestNumber])
  @@index([requestedBy])
  @@map("data_share_requests")
}

// Data Share Documents - Additional documents for data sharing
model DataShareDocument {
  id              String              @id @default(uuid()) @db.Uuid
  requestId       String              @db.Uuid
  request         DataShareRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  
  // Document details
  documentType    String              // e.g., "Authorization Letter", "Medical Records"
  fileName        String              // Original file name
  fileUrl         String              // Path or URL to stored file
  fileSize        Int                 // Size in bytes
  mimeType        String              // File MIME type
  
  // Metadata
  description     String?             // Optional description
  uploadedBy      String              // User ID who uploaded
  
  // System fields
  createdAt       DateTime            @default(now())
  
  @@index([requestId])
  @@map("data_share_documents")
}

// Data Share Access Tokens - For external hospital to access patient data
model DataShareAccessToken {
  id              String              @id @default(uuid()) @db.Uuid
  requestId       String              @db.Uuid
  request         DataShareRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  
  // Token details
  token           String              @unique // Secure random token
  recipientEmail  String              // Hospital email
  
  // Expiration and usage
  expiresAt       DateTime            // Token expiration (e.g., 30 days)
  usedAt          DateTime?           // When token was first used
  isRevoked       Boolean             @default(false) // Can be manually revoked
  
  // System fields
  createdAt       DateTime            @default(now())
  
  @@index([token])
  @@index([requestId])
  @@index([expiresAt])
  @@map("data_share_access_tokens")
}

// Data Share Status Enum
enum DataShareStatus {
  PENDING         // Created by doctor/nurse, awaiting review
  SUBMITTED       // Submitted for staff review
  APPROVED        // Approved by staff, token sent to hospital
  DENIED          // Denied by staff
  ACCESSED        // Hospital has accessed the data
  EXPIRED         // Token expired before use
  CANCELLED       // Cancelled by requester
}

// ============================================
// BILLING SYSTEM MODELS
// ============================================

// Billing Transaction - Main billing record for an encounter
model BillingTransaction {
  id                  String                @id @default(uuid()) @db.Uuid
  transactionNumber   String                @unique // Auto-generated: BT-{year}{month}-{seq}
  patientId           String
  patient             Patient               @relation(fields: [patientId], references: [id])
  encounterId         String?               @db.Uuid @unique // Optional - can create bills without encounter
  encounter           InpatientEncounter?   @relation(fields: [encounterId], references: [id])
  
  // Transaction status
  status              BillingStatus         @default(PENDING)
  totalAmount         Decimal               @db.Decimal(12, 2) // Total before insurance
  insuranceDiscount   Decimal               @default(0) @db.Decimal(12, 2) // Total insurance coverage
  finalAmount         Decimal               @db.Decimal(12, 2) // After insurance discount
  paidAmount          Decimal               @default(0) @db.Decimal(12, 2) // Amount paid so far
  balanceAmount       Decimal               @db.Decimal(12, 2) // Remaining balance
  
  // Pre-authorization tracking
  hasPreAuth          Boolean               @default(false) // Has pre-auth items
  preAuthSettled      Boolean               @default(false) // All pre-auth items settled
  
  // Payment plan
  hasPaymentPlan      Boolean               @default(false)
  paymentPlan         PaymentPlan?
  
  // Relationships
  lineItems           BillingLineItem[]
  payments            BillingPayment[]
  
  // System fields
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  createdBy           String?               // Staff who created
  
  @@index([patientId])
  @@index([status])
  @@index([transactionNumber])
  @@map("billing_transactions")
}

// Billing Line Item - Individual charges/particulars
model BillingLineItem {
  id                  String                @id @default(uuid()) @db.Uuid
  transactionId       String                @db.Uuid
  transaction         BillingTransaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  // Item details
  itemType            BillingItemType
  description         String
  quantity            Int                   @default(1)
  unitPrice           Decimal               @db.Decimal(10, 2)
  totalPrice          Decimal               @db.Decimal(10, 2) // quantity * unitPrice
  
  // Pre-authorization
  requiresPreAuth     Boolean               @default(false)
  preAuthPaid         Boolean               @default(false)
  preAuthPaymentId    String?               @db.Uuid
  preAuthPayment      BillingPayment?       @relation("PreAuthPayment", fields: [preAuthPaymentId], references: [id])
  
  // Insurance coverage
  insuranceCoverable  Boolean               @default(false)
  insuranceCoverage   InsuranceCoverage?
  insuranceDiscount   Decimal               @default(0) @db.Decimal(10, 2)
  finalPrice          Decimal               @db.Decimal(10, 2) // After insurance discount
  
  // Link to encounter order
  encounterOrderId    String?               @db.Uuid
  encounterOrder      InpatientEncounterOrder? @relation(fields: [encounterOrderId], references: [id])
  
  // System fields
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  addedBy             String?               // Staff/doctor who added
  
  @@index([transactionId])
  @@index([requiresPreAuth])
  @@map("billing_line_items")
}

// Insurance Coverage - Coverage details for specific items
model InsuranceCoverage {
  id                  String              @id @default(uuid()) @db.Uuid
  lineItemId          String              @db.Uuid @unique
  lineItem            BillingLineItem     @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  
  // Insurance details
  insuranceProvider   String
  insuranceNumber     String
  coveragePercentage  Decimal             @db.Decimal(5, 2) // e.g., 60.00 for 60%
  coverageAmount      Decimal             @db.Decimal(10, 2) // Actual discount amount
  
  // Claim status
  claimStatus         InsuranceClaimStatus @default(PENDING)
  claimNumber         String?
  claimNotes          String?
  
  // System fields
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  verifiedBy          String?             // Staff who verified
  
  @@index([insuranceProvider])
  @@index([claimStatus])
  @@map("insurance_coverages")
}

// Billing Payment - Payment records
model BillingPayment {
  id                  String              @id @default(uuid()) @db.Uuid
  paymentNumber       String              @unique // Auto-generated: PAY-{year}{month}-{seq}
  transactionId       String              @db.Uuid
  transaction         BillingTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  // Payment details
  amount              Decimal             @db.Decimal(10, 2)
  paymentMethod       PaymentMethod
  paymentType         PaymentType         // ONE_TIME or INSTALLMENT
  
  // Pre-auth tracking
  isPreAuthPayment    Boolean             @default(false)
  preAuthItems        BillingLineItem[]   @relation("PreAuthPayment")
  
  // Payment plan installment
  paymentPlanId       String?             @db.Uuid
  paymentPlan         PaymentPlan?        @relation(fields: [paymentPlanId], references: [id])
  installmentNumber   Int?                // Which installment (1, 2, 3, etc.)
  
  // Maya payment gateway
  mayaPaymentId       String?             @unique // Maya transaction ID
  mayaPaymentStatus   String?             // Maya payment status
  mayaReceiptUrl      String?             // Receipt URL from Maya
  
  // Payment status
  status              PaymentStatus       @default(PENDING)
  paidAt              DateTime?
  
  // System fields
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  processedBy         String?             // Staff who processed
  
  @@index([transactionId])
  @@index([status])
  @@index([paymentMethod])
  @@map("billing_payments")
}

// Payment Plan - Installment payment setup
model PaymentPlan {
  id                  String              @id @default(uuid()) @db.Uuid
  transactionId       String              @db.Uuid @unique
  transaction         BillingTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  // Plan details
  totalAmount         Decimal             @db.Decimal(10, 2) // Total amount to pay (non-pre-auth only)
  installmentCount    Int                 // Number of installments (e.g., 3, 6, 12)
  installmentAmount   Decimal             @db.Decimal(10, 2) // Amount per installment
  frequency           PaymentFrequency    // MONTHLY, BI_WEEKLY, WEEKLY
  
  // Payment tracking
  paidInstallments    Int                 @default(0)
  remainingAmount     Decimal             @db.Decimal(10, 2)
  
  // Maya recurring setup
  mayaSubscriptionId  String?             @unique // Maya subscription ID for recurring
  mayaNextChargeDate  DateTime?
  
  // Status
  status              PaymentPlanStatus   @default(ACTIVE)
  startDate           DateTime
  nextDueDate         DateTime
  
  // Relationships
  payments            BillingPayment[]
  
  // System fields
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  setupBy             String?             // Staff who set up the plan
  
  @@index([status])
  @@index([nextDueDate])
  @@map("payment_plans")
}

// Enums for Billing System
enum BillingStatus {
  PENDING           // Initial state, not yet settled
  PARTIALLY_PAID    // Some payments made
  PAID              // Fully paid
  OVERDUE           // Payment plan overdue
  CANCELLED         // Cancelled
}

enum BillingItemType {
  ROOM_CHARGE
  CONSULTATION
  LABORATORY
  RADIOLOGY
  MEDICATION
  PROCEDURE
  SURGERY
  SUPPLIES
  OTHER
}

enum PaymentType {
  ONE_TIME
  INSTALLMENT
}

enum PaymentFrequency {
  WEEKLY
  BI_WEEKLY
  MONTHLY
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}
