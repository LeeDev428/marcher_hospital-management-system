generator client {
  provider = "prisma-client-js"
  output   = "../generated/instance"
}

datasource db {
  provider = "postgresql"
  url      = env("INSTANCE_DATABASE_URL")
}

// Enhanced User Model - Single table for all users
model User {
  id              String     @id @default(cuid())
  email           String     @unique
  password        String // Hashed password
  firstName       String
  lastName        String
  middleName      String?
  phone           String?
  role            UserRole   @default(PATIENT)
  status          UserStatus @default(ACTIVE)
  isEmailVerified Boolean    @default(false)
  emailVerifiedAt DateTime?

  // Profile information
  avatar      String?
  dateOfBirth DateTime?
  gender      Gender?
  address     String?
  city        String?
  province    String?
  zipCode     String?

  // Staff-specific fields (only used when role = STAFF)
  staffNumber    String?         @unique // Auto-generated for staff
  department     String? // Department they work in
  position       String? // Job position
  hireDate       DateTime? // When they were hired
  salary         Decimal? // Salary information
  employmentType EmploymentType? // Full-time, part-time, contract

  // System fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relationships
  refreshTokens    RefreshToken[]
  passwordResets   PasswordResetToken[]
  patientProfile   Patient?
  partnerProfile   Partner?
  staffCredentials StaffCredentials? // Professional credentials for staff
  appointments     Appointment[]
  medicalServices  MedicalService[] // Services offered by this staff member

  // Audit fields
  createdBy String?
  updatedBy String?

  @@map("users")
}

// Staff Credentials - For doctors, nurses, and other medical staff
model StaffCredentials {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Professional Type
  staffType StaffType // DOCTOR, NURSE, TECHNICIAN, etc.

  // License and Certifications
  licenseNumber      String?
  licenseExpiryDate  DateTime?
  specialization     String?
  subSpecialization  String?
  boardCertification String[] // Array of certifications

  // Education and Experience
  education         String?
  yearsOfExperience Int?

  // Medical staff specific fields
  consultationFee Decimal? // For doctors
  isAvailable     Boolean  @default(true)
  workingHours    Json? // Flexible schedule data

  // Hospital/Institution info
  hospitalAffiliation String?

  // System fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff_credentials")
}

// Patient Profile (simplified)
model Patient {
  id            String @id @default(cuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientNumber String @unique

  // Medical Information
  bloodType        BloodType?
  allergies        String?
  medicalHistory   String?
  emergencyContact String?
  emergencyPhone   String?

  // Insurance Information
  insuranceProvider String?
  insuranceNumber   String?

  // Relationships
  inpatientEncounters  InpatientEncounter[]
  outpatientEncounters OutpatientEncounter[]
  insuranceClaims      InsuranceClaim[]

  // System fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patients")
}

// Partner Profile (Hospital/Clinic)
model Partner {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionName String
  institutionType PartnerType
  licenseNumber   String?

  // Contact Information
  website       String?
  contactPerson String?

  // System fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partners")
}

// Refresh Tokens for JWT
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// Password Reset Tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token, expiresAt, used])
  @@map("password_reset_tokens")
}

// Appointments Model
model Appointment {
  id       String @id @default(cuid())
  userId   String // Patient's user ID - references User.id
  user     User   @relation(fields: [userId], references: [id])
  doctorId String // References User.id where role = STAFF and staffType = DOCTOR

  // Medical Service
  medicalServiceId String? // References MedicalService.id
  medicalService   MedicalService? @relation(fields: [medicalServiceId], references: [id])

  // Appointment details
  date       String // Date in YYYY-MM-DD format
  time       String // Time in HH:MM format (24-hour)
  duration   Int? // Duration in minutes
  type       AppointmentType?
  status     AppointmentStatus @default(SCHEDULED)
  reason     String?
  notes      String?
  facilityId String? // Room assignment

  // System fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([doctorId])
  @@index([medicalServiceId])
  @@index([date])
  @@index([status])
  @@map("appointments")
}

// ENUMS

// User Roles
enum UserRole {
  ADMIN
  STAFF // Covers doctors, nurses, technicians, etc.
  PATIENT
  PARTNER
}

// Staff Types (for detailed classification)
enum StaffType {
  DOCTOR
  NURSE
  STAFF
  ADMISSIONS_STAFF
  BILLING_STAFF
  PHARMACIST
}

// Employment Types
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CONSULTANT
  INTERN
}

// User Status
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

// Gender Enum
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// Partner Type Enum
enum PartnerType {
  HOSPITAL
  CLINIC
  LABORATORY
  PHARMACY
  DIAGNOSTIC_CENTER
}

// Blood Type Enum
enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

// Appointment Types
enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
  PROCEDURE
  CHECKUP
}

// Appointment Status
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Day of Week for schedule
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Staff Schedule - Weekly availability
model StaffSchedule {
  id          String    @id @default(cuid())
  staffId     String // User ID of the staff member
  day         DayOfWeek
  isAvailable Boolean   @default(false)
  startTime   String? // HH:mm format
  endTime     String? // HH:mm format

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, day])
  @@map("staff_schedules")
}

// Medical Services - Services offered by staff
model MedicalService {
  id          String           @id @default(cuid())
  staffId     String // User ID of the staff member offering this service
  staff       User             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  name        String // Service name (e.g., "General Consultation", "Blood Pressure Check")
  type        ServiceType // Type of service
  category    ServiceCategory? // Optional category for grouping
  description String? // Detailed description of the service
  price       Decimal          @db.Decimal(10, 2) // Price in currency
  duration    Int // Duration in minutes
  isActive    Boolean          @default(true) // Can be disabled without deleting

  // Additional fields
  requirements String? // Any requirements/preparations needed
  notes        String? // Internal notes

  // Relations
  appointments Appointment[] // Appointments using this service

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([type])
  @@index([isActive])
  @@map("medical_services")
}

// Service Type Enum
enum ServiceType {
  CONSULTATION // General consultation
  FOLLOW_UP // Follow-up consultation
  MINOR_PROCEDURE // Minor procedures (injections, wound care, etc.)
  MAJOR_PROCEDURE // Major procedures (surgery, etc.)
  DIAGNOSTIC_TEST // Diagnostic tests
  VACCINATION // Vaccination services
  HEALTH_CHECKUP // General health checkup
  SPECIALIZED_CONSULTATION // Specialized consultation
  EMERGENCY_CARE // Emergency care
  PREVENTIVE_CARE // Preventive care
  THERAPY // Physical therapy, occupational therapy, etc.
  COUNSELING // Mental health counseling
  OTHER // Other services
}

// Service Category Enum (for better organization)
enum ServiceCategory {
  GENERAL_MEDICINE
  SURGERY
  PEDIATRICS
  OBSTETRICS_GYNECOLOGY
  ORTHOPEDICS
  CARDIOLOGY
  NEUROLOGY
  DERMATOLOGY
  OPHTHALMOLOGY
  ENT
  PSYCHIATRY
  RADIOLOGY
  LABORATORY
  NURSING
  THERAPY
  EMERGENCY
  OTHER
}

// ==================== PHARMACY MODELS ====================

// Pharmacy Supplier
model PharmacySupplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String?
  contact   String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([email])
  @@index([contact])
  @@map("pharmacy_suppliers")
}

// Pharmacy Brand
model PharmacyBrand {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  items     PharmacyItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([name])
  @@map("pharmacy_brands")
}

// Pharmacy Item Category
model PharmacyItemCategory {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  items     PharmacyItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([name])
  @@map("pharmacy_item_categories")
}

// Pharmacy Item Forms
enum PharmacyItemForm {
  TABLET
  CAPSULE
  SYRUP
  OINTMENT
  CREAM
  INJECTION
  DROPS
  INHALER
  MEDICAL_DEVICE
  SUPPLEMENTS
  COSMETICS
  MISCELLANEOUS
}

// Pharmacy Item Routes
enum PharmacyItemRoute {
  INJECTION
  TOPICAL
  TRANSDERMAL
  OCULAR
  OTIC
  NASAL
  ORAL
  INHALATIONAL
  RECTAL
  VAGINAL
}

// Pharmacy Item
model PharmacyItem {
  id         String               @id @default(uuid()) @db.Uuid
  brandId    String               @db.Uuid
  brand      PharmacyBrand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId String               @db.Uuid
  category   PharmacyItemCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name       String
  form       PharmacyItemForm
  route      PharmacyItemRoute
  strength   String
  stock      Int
  unit       String
  price      Decimal              @default(0) @db.Decimal(10, 2)
  sku        String?
  saleItems  PharmacySaleItem[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([name])
  @@map("pharmacy_items")
}

// Payment Methods
enum PaymentMethod {
  CASH
  CARD
  ONLINE
  INSURANCE
}

// Payment Status
enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

// Pharmacy Sale (POS)
model PharmacySale {
  id            String             @id @default(uuid()) @db.Uuid
  invoiceNumber String             @unique
  customerName  String?
  customerPhone String?
  staffId       String?
  subtotal      Decimal            @db.Decimal(10, 2)
  discount      Decimal            @default(0) @db.Decimal(10, 2)
  tax           Decimal            @default(0) @db.Decimal(10, 2)
  total         Decimal            @db.Decimal(10, 2)
  amountPaid    Decimal?           @db.Decimal(10, 2) // Amount customer actually paid
  changeGiven   Decimal?           @db.Decimal(10, 2) // Change returned to customer (calculated: amountPaid - total)
  paymentMethod PaymentMethod      @default(CASH)
  paymentStatus PaymentStatus      @default(COMPLETED)
  notes         String?
  items         PharmacySaleItem[]
  payments      PharmacyPayment[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([invoiceNumber])
  @@index([createdAt])
  @@index([staffId])
  @@map("pharmacy_sales")
}

// Pharmacy Sale Item
model PharmacySaleItem {
  id             String       @id @default(uuid()) @db.Uuid
  saleId         String       @db.Uuid
  sale           PharmacySale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  pharmacyItemId String       @db.Uuid
  pharmacyItem   PharmacyItem @relation(fields: [pharmacyItemId], references: [id], onDelete: Restrict)
  quantity       Int
  unitPrice      Decimal      @db.Decimal(10, 2)
  subtotal       Decimal      @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([saleId])
  @@index([pharmacyItemId])
  @@map("pharmacy_sale_items")
}

// Pharmacy Payment
model PharmacyPayment {
  id            String        @id @default(uuid()) @db.Uuid
  saleId        String        @db.Uuid
  sale          PharmacySale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod @default(CASH)
  transactionId String?
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([saleId])
  @@map("pharmacy_payments")
}

// ==================== ENCOUNTERS MODULE ====================

// Outpatient Encounter Types
enum OutpatientEncounterType {
  CONSULTATION
  FOLLOW_UP
  LABORATORY
  RADIOLOGY
  OTHER
}

// Outpatient Payment Status
enum OutpatientPaymentStatus {
  PAID
  UNPAID
}

// Outpatient Encounter - Created by doctors for consultations
model OutpatientEncounter {
  id              String                  @id @default(uuid()) @db.Uuid
  patientId       String
  patient         Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String // User ID of the doctor
  date            String // Date in YYYY-MM-DD format
  time            String // Time in HH:MM format
  chiefComplaint  String // Main reason for visit
  doctorDiagnosis String? // Doctor's diagnosis
  type            OutpatientEncounterType @default(CONSULTATION)
  consultationFee Decimal?                @db.Decimal(10, 2) // Doctor sets this directly
  paymentStatus   OutpatientPaymentStatus @default(UNPAID)
  notes           String? // Additional notes
  insuranceClaim  InsuranceClaim? // Insurance claim for this encounter
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@map("outpatient_encounters")
}

// Inpatient Triage Levels
enum InpatientTriage {
  HIGH_PRIORITY
  MEDIUM_PRIORITY
  LOW_PRIORITY
  NON_URGENT
}

// Inpatient Disposition Status
enum InpatientDisposition {
  ADMITTED
  DISCHARGED
  DISCONTINUED
  TRANSFERRED
  DECEASED
  OTHER
}

// Inpatient Encounter - Created by admissions staff
model InpatientEncounter {
  id              String                    @id @default(uuid()) @db.Uuid
  patientId       String
  patient         Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String // Assigned doctor (User ID)
  admittedBy      String? // Admissions staff who created this (User ID)
  date            String // Admission date in YYYY-MM-DD format
  time            String // Admission time in HH:MM format
  chiefComplaint  String // Initial complaint/reason for admission
  doctorDiagnosis String? // Doctor's diagnosis
  triage          InpatientTriage // Priority level
  disposition     InpatientDisposition      @default(ADMITTED)
  dispositionDate String? // Discharge/transfer date
  dispositionTime String? // Discharge/transfer time
  dispositionNote String? // Notes about disposition
  charts          InpatientEncounterChart[] // Progress notes by doctor
  orders          InpatientEncounterOrder[] // Orders/particulars added by doctor
  insuranceClaim  InsuranceClaim? // Insurance claim for this encounter
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([disposition])
  @@index([date])
  @@map("inpatient_encounters")
}

// Inpatient Encounter Chart - Progress notes added by doctor
model InpatientEncounterChart {
  id          String             @id @default(uuid()) @db.Uuid
  encounterId String             @db.Uuid
  encounter   InpatientEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  staffId     String // Doctor who added the chart (User ID)
  chart       String // Chart/progress note content
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([encounterId])
  @@index([staffId])
  @@map("inpatient_encounter_charts")
}

// Inpatient Encounter Order Types
enum InpatientEncounterOrderType {
  PRESCRIPTION
  LABORATORY
  RADIOLOGY
  OPERATION
  PROCEDURE
  OTHER
}

// Inpatient Encounter Order Status
enum InpatientEncounterOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Inpatient Encounter Order - Orders/particulars added by doctor from catalogue
model InpatientEncounterOrder {
  id              String                        @id @default(uuid()) @db.Uuid
  encounterId     String                        @db.Uuid
  encounter       InpatientEncounter            @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  catalogueItemId String?                       @db.Uuid // Reference to ParticularCatalogue
  catalogueItem   ParticularCatalogue?          @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)
  type            InpatientEncounterOrderType
  description     String // Order description
  cost            Decimal                       @db.Decimal(10, 2) // Cost from catalogue or custom
  status          InpatientEncounterOrderStatus @default(PENDING)
  orderedBy       String // Doctor who ordered (User ID)
  notes           String? // Additional notes
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([encounterId])
  @@index([catalogueItemId])
  @@index([status])
  @@map("inpatient_encounter_orders")
}

// ==================== PARTICULARS CATALOGUE ====================

// Particular Item Types (matches InpatientEncounterOrderType)
enum ParticularType {
  PRESCRIPTION
  LABORATORY
  RADIOLOGY
  OPERATION
  PROCEDURE
  OTHER
}

// Particulars Catalogue - Managed by billing staff
model ParticularCatalogue {
  id          String                    @id @default(uuid()) @db.Uuid
  type        ParticularType
  name        String // e.g., "Hepatitis A Blood Test"
  description String? // Detailed description
  cost        Decimal                   @db.Decimal(10, 2) // Standard cost
  isActive    Boolean                   @default(true) // Can be disabled
  orders      InpatientEncounterOrder[] // Orders that used this catalogue item
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([type])
  @@index([isActive])
  @@index([name])
  @@map("particular_catalogue")
}

// ==================== INSURANCE SYSTEM ====================

// Insurance Claim Status
enum InsuranceClaimStatus {
  PENDING // Waiting for documents upload
  SUBMITTED // Documents uploaded, token sent
  UNDER_REVIEW // Insurance company reviewing
  APPROVED // Claim approved by insurance
  DENIED // Claim denied by insurance
  CANCELLED // Cancelled by billing staff
}

// Insurance Claims - Main claim record
model InsuranceClaim {
  id          String @id @default(uuid()) @db.Uuid
  claimNumber String @unique // Auto-generated: INS-YYYYMMDD-XXXX

  // Patient and Encounter
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Can be either inpatient or outpatient encounter
  inpatientEncounterId String?             @unique @db.Uuid
  inpatientEncounter   InpatientEncounter? @relation(fields: [inpatientEncounterId], references: [id], onDelete: Cascade)

  outpatientEncounterId String?              @unique @db.Uuid
  outpatientEncounter   OutpatientEncounter? @relation(fields: [outpatientEncounterId], references: [id], onDelete: Cascade)

  // Insurance Details
  insuranceProvider String // Insurance company name
  insuranceNumber   String? // Patient's insurance number
  policyNumber      String? // Policy number

  // Claim Details
  claimAmount    Decimal  @db.Decimal(10, 2) // Total amount claimed
  approvedAmount Decimal? @db.Decimal(10, 2) // Amount approved by insurance
  denialReason   String? // Reason if denied

  // Status and workflow
  status      InsuranceClaimStatus @default(PENDING)
  submittedAt DateTime? // When documents were submitted
  reviewedAt  DateTime? // When insurance reviewed

  // Notes
  billingStaffNotes String? // Notes from billing staff
  insuranceNotes    String? // Notes from insurance company

  // Staff who created/managed
  createdBy  String // User ID of billing staff
  reviewedBy String? // Email of insurance reviewer

  // Relationships
  documents    InsuranceDocument[]
  accessTokens InsuranceAccessToken[]

  // System fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([status])
  @@index([claimNumber])
  @@index([insuranceProvider])
  @@map("insurance_claims")
}

// Insurance Documents - Files uploaded for claim
model InsuranceDocument {
  id      String         @id @default(uuid()) @db.Uuid
  claimId String         @db.Uuid
  claim   InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  // Document details
  documentType String // e.g., "Medical Certificate", "Laboratory Results", "Prescription"
  fileName     String // Original file name
  fileUrl      String // Path or URL to stored file
  fileSize     Int // Size in bytes
  mimeType     String // File MIME type

  // Metadata
  description String? // Optional description
  uploadedBy  String // User ID who uploaded

  // System fields
  createdAt DateTime @default(now())

  @@index([claimId])
  @@map("insurance_documents")
}

// Insurance Access Tokens - For insurance company to access claim
model InsuranceAccessToken {
  id      String         @id @default(uuid()) @db.Uuid
  claimId String         @db.Uuid
  claim   InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  // Token details
  token          String @unique // Secure random token
  recipientEmail String // Insurance company email

  // Expiration and usage
  expiresAt DateTime // Token expiration (e.g., 7 days)
  usedAt    DateTime? // When token was first used
  isRevoked Boolean   @default(false) // Can be manually revoked

  // System fields
  createdAt DateTime @default(now())

  @@index([token])
  @@index([claimId])
  @@index([expiresAt])
  @@map("insurance_access_tokens")
}
